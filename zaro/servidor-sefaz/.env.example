# Copie para .env e preencha. Nunca envie o .env nem o .pfx para o repositório.
PORT=8787
# token que o ZARO usa para falar com este servidor (gere um valor longo e aleatório)
ZARO_TOKEN=
# homologacao | producao
AMBIENTE=homologacao
# código IBGE da UF do autor da consulta (AM = 13)
UF_AUTOR=13
# certificado A1 da empresa (arquivo .pfx) e senha
CERT_PFX_PATH=./certificado.pfx
CERT_PFX_SENHA=
# endereço onde o ZARO está aberto (restrinja em produção)
CORS_ORIGIN=*
NSU_FILE=./nsu.json
