    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.2",
    "next": "15.5.28",
    "pg": "8.16.3",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "drizzle-kit": "0.31.4",
