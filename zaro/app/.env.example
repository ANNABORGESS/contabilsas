# Copie para .env (na pasta app) e preencha só o que for usar.

# Banco de dados. Em branco: usa o banco embutido na pasta ./dados (um computador só).
# Para usar na nuvem ou em rede, informe um PostgreSQL (Supabase, Neon ou servidor próprio):
# DATABASE_URL=postgresql://usuario:senha@servidor:5432/zaro
DATABASE_URL=

# Pasta dos dados (banco embutido e arquivos). Padrão: ./dados
ZARO_DATA_DIR=

# Chave da Anthropic para o Conselho ZARO (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Use 1 quando o ZARO estiver publicado com HTTPS (cookie de login só por conexão segura)
ZARO_COOKIE_SEGURO=
