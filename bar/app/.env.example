# Copie para .env (na pasta app) e preencha só o que for usar.

# Banco de dados. Em branco: usa o PostgreSQL embutido na pasta ./dados (o computador do caixa é o servidor).
# Para usar na nuvem, informe um PostgreSQL (Supabase, Neon ou servidor próprio):
# DATABASE_URL=postgresql://usuario:senha@servidor:5432/bar
DATABASE_URL=

# Pasta dos dados do banco embutido. Padrão: ./dados
BAR_DATA_DIR=

# Fuso e hora da virada do turno (vendas antes dessa hora contam no dia anterior)
BAR_FUSO=America/Sao_Paulo
BAR_VIRADA_HORA=6

# Use 1 quando estiver publicado com HTTPS (cookie de login só por conexão segura)
BAR_COOKIE_SEGURO=

# Schema do banco quando ele é compartilhado com outro sistema (ex.: bar). Em branco: schema padrão.
BAR_DB_SCHEMA=
