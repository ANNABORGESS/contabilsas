{
  "name": "bar-app",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de bar com pagamento na mesa: celular do garçom, painéis da cozinha e do bar e administração no computador.",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3100",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3100",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.3.16",
    "drizzle-orm": "0.45.3",
    "next": "15.5.28",
    "pg": "8.16.3",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "drizzle-kit": "0.31.4",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
